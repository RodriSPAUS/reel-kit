# Copy this file to `.env` and fill in only what you use.
# `.env` is ignored by git, so your keys stay on your computer.
# Never paste a real key into this file, the README or any other tracked file.

# --- Optional: ElevenLabs voices (paid, best quality) ---
# Only needed for: npm run voice -- <reel> --engine elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional: render in the cloud with AWS Lambda ---
# Only needed if you follow docs/render-on-aws.md. Rendering on your own
# computer (npm run render) needs none of this.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=

# --- Optional: use a browser you already have ---
REMOTION_BROWSER_EXECUTABLE=
